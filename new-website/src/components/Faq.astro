---
// FAQ (#faq) · eyebrow "Before you ask" (§8). Copy verbatim.
// Native <details>/<summary>: keyboard-operable + works with no JS (§10).
// Emits schema.org/FAQPage JSON-LD for rich results (§8/§10).
// NOTE (§8 TODOs): the "free" answer should later summarise a premium tier if
// one exists; the providers answer should list current support. Kept clean
// here — TODO copy never ships inside the visible/structured answer.
const faqs = [
  {
    q: 'Is my email actually safe?',
    a: 'Yes. Kosha requests read-only access through official, Google-verified OAuth. We can find your documents but can never send, edit, or delete anything. Your email password is never seen or stored.',
  },
  {
    q: 'Do you sell or train on my data?',
    a: 'Never. Your data isn’t sold, shared, or used to train any model. You can disconnect and delete everything from the app at any time.',
  },
  {
    q: 'Is it really free?',
    a: 'Yes — free to start, no credit card.',
  },
  {
    q: 'Which email providers and platforms are supported?',
    a: 'Gmail today, with more providers and channels rolling out.',
  },
  {
    q: 'What’s the difference from a notes or to-do app?',
    a: 'You don’t enter anything. Kosha captures the important stuff automatically from where it already lives, then filters and reminds — so there’s nothing to maintain.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section class="section faq" id="faq">
  <div class="container faq__container">
    <div class="section__head" data-sr>
      <p class="eyebrow">Before you ask</p>
      <h2 class="section__title">Questions, answered.</h2>
    </div>

    <div class="faq__list" data-sr data-sr-delay="1">
      {
        faqs.map((f) => (
          <details class="faq__item" name="faq">
            <summary class="faq__q">
              <span>{f.q}</span>
              <span class="faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="faq__a">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq__container {
    max-width: 800px;
  }

  .faq__list {
    border-top: 1px solid var(--line);
  }

  .faq__item {
    border-bottom: 1px solid var(--line);
  }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.4rem 0;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    color: var(--ink);
    list-style: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__q:focus-visible {
    outline: 2px solid var(--gold-bright);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* Plus → minus icon (gold hairlines) */
  .faq__icon {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: "";
    position: absolute;
    background: var(--gold);
    transition: transform var(--dur) var(--ease), opacity var(--dur) var(--ease);
  }
  .faq__icon::before {
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    transform: translateY(-50%);
  }
  .faq__icon::after {
    left: 50%;
    top: 0;
    width: 1.5px;
    height: 100%;
    transform: translateX(-50%);
  }
  .faq__item[open] .faq__icon::after {
    transform: translateX(-50%) scaleY(0);
    opacity: 0;
  }

  .faq__a {
    padding: 0 0 1.5rem;
    color: var(--ink-soft);
    max-width: 64ch;
  }
  .faq__a p {
    margin: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__icon::before,
    .faq__icon::after {
      transition: none;
    }
  }
</style>
