---
// Solutions — the pipeline (§5): capture → filter → anticipate. Each step is
// its own section: a centered intro (title pill → heading → crisp subheading)
// over a two-card bento grid. Each card carries an animated phone mock whose
// screen matches the feature. FILTER stays one of the two dark bands (§3).
import PhoneMock from './PhoneMock.astro';

const solutions = [
  {
    verb: 'Capture',
    dark: false,
    title: 'Nothing important slips through.',
    body: 'Kosha quietly captures what matters across your inbox and channels.',
    cards: [
      {
        kind: 'email',
        name: 'Email intelligence',
        desc: 'Read-only parsing finds documents and deadlines. Credentials never stored.',
      },
      {
        kind: 'retrieval',
        name: 'Instant retrieval',
        desc: 'Ask for any bill or report — it surfaces in seconds, not searches.',
      },
    ],
  },
  {
    verb: 'Filter',
    dark: true,
    title: 'Only what matters reaches you.',
    body: 'Kosha learns your signal from your noise, so attention goes where it’s needed.',
    cards: [
      {
        kind: 'spam',
        name: 'Spam call shield',
        desc: 'Loan offers and telemarketing are blocked before your phone rings.',
      },
      {
        kind: 'priority',
        name: 'Priority ranking',
        desc: 'The right thing surfaces at the right moment — not all at once.',
      },
    ],
  },
  {
    verb: 'Anticipate',
    dark: false,
    title: 'Kosha thinks ahead for you.',
    body: 'It tracks your habits and plans, then nudges you gently at the right moment.',
    cards: [
      {
        kind: 'habit',
        name: 'Habit engine',
        desc: 'Streaks that survive real life — recover your routine after a miss.',
      },
      {
        kind: 'planner',
        name: 'Life planner',
        desc: 'Meals, medicines, groceries — your week planned in minutes.',
      },
    ],
  },
];
---

{
  solutions.map((s) => (
    <section id={s.verb.toLowerCase()} class:list={['section', 'solution', { 'section--dark': s.dark }]}>
      <div class="container">
        {/* ---- Centered intro: title pill → heading → subheading ---- */}
        <div class="solution__head section__head" data-sr>
          <p class="solution__pill">{s.verb}</p>
          <h2 class="solution__title section__title">{s.title}</h2>
          <p class="solution__body lede">{s.body}</p>
        </div>

        {/* ---- Two-card bento grid (image space + label) ---- */}
        <div class="solution__grid">
          {s.cards.map((c, ci) => (
            <article class="solution__card" data-sr data-sr-delay={ci + 1}>
              <div class="solution__card-body">
                <h3 class="solution__card-name">{c.name}</h3>
                <p class="solution__card-desc">{c.desc}</p>
              </div>
              <div class="solution__media">
                <PhoneMock kind={c.kind} />
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))
}

<style>
  /* ---- Centered intro (width/centering inherited from .section__head) ---- */
  .solution__head {
    margin-bottom: clamp(2.5rem, 5vw, 4.5rem);
  }

  /* Title pill — the verb, in a soft rounded chip (reference "Features" pill) */
  .solution__pill {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-sm);
    padding: 0.5rem 1.1rem;
    margin: 0;
  }

  .section--dark .solution__pill {
    color: var(--accent-bright);
    background: var(--band-raised);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .solution__title {
    margin: 1.1rem 0 0;
  }

  .solution__body {
    margin: 1rem auto 0;
    max-width: 46ch;
  }

  /* ---- Bento grid ---- */
  .solution__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: clamp(1rem, 2.5vw, 1.75rem);
  }

  /* Borderless panel — text on top, phone bleeds in from the bottom (cropped) */
  .solution__card {
    display: flex;
    flex-direction: column;
    background: #f6f6fa;
    border: none;
    box-shadow: none;
    border-radius: var(--radius);
    padding: clamp(0.5rem, 1.5vw, 1.25rem);
    padding-bottom: 0;
    overflow: hidden;
  }

  .section--dark .solution__card {
    background: rgba(255, 255, 255, 0.08);
  }

  /* Stage for the animated phone — zoomed in and clipped at the card's bottom */
  .solution__media {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: clamp(1rem, 3vw, 2rem) 0 0;
  }

  /* Larger device (zoom) whose lower portion is cropped by the card.
     Height = width * 18.6/9, so cropping 40% of the height (showing ~60%)
     means pulling up 0.83 * width — exact at every viewport size. */
  .solution__media :global(.phone) {
    width: clamp(202px, 74%, 254px);
    margin-bottom: calc(clamp(202px, 74%, 254px) * -0.83);
  }

  .solution__card-body {
    padding: clamp(1rem, 2vw, 1.5rem) 0.4rem clamp(0.5rem, 1.5vw, 1rem);
    text-align: center;
  }

  .solution__card-name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-weight: 500;
    margin: 0 0 0.4rem;
  }

  .solution__card-desc {
    color: var(--ink-soft);
    font-size: 0.95rem;
    margin: 0 auto;
    max-width: 34ch;
  }

  .section--dark .solution__card-desc {
    color: color-mix(in srgb, var(--paper-raised) 72%, transparent);
  }

  @media (max-width: 880px) {
    .solution__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
