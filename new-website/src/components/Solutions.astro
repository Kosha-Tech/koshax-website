---
// Solutions — the pipeline (§5): Capture → Calibrate → Think → Anticipate →
// Coordinate, combined into ONE section. Headline-as-tabs switcher sits
// top-left; each view shows its stage badge (Learn / Understand / Act),
// tagline, body, a "How it works" explainer box, and an "In action" panel of
// example cards. Auto-rotates every few seconds; clicking a verb locks it.
// No-JS fallback: the five panels simply stack.
const solutions = [
  {
    verb: 'Capture',
    stage: 'Learn',
    title: 'Nothing slips through.',
    body: 'KoshaX quietly pulls in context from everywhere you already are, and when something lives only in your head, just tell Kai. You live your life; KoshaX takes notes.',
    how: 'Connectors ingest from email, calendar, WhatsApp, voice notes, meetings and reminders, then normalize everything into a single timeline of events.',
    actions: [
      { label: 'From email', text: '“Mom’s flight lands Sat 6pm — DEL T3”' },
      { label: 'Voice note', text: '“Remind me to renew the car insurance”' },
      { label: 'WhatsApp', text: '“Dinner with the Sharmas next Friday?”' },
    ],
  },
  {
    verb: 'Calibrate',
    stage: 'Learn',
    title: 'It learns what matters to you.',
    body: 'Every input is organized into a living knowledge graph of your patterns, priorities, relationships and routines. Over time KoshaX learns your signal from your noise.',
    how: 'Entities (people, places, recurring tasks) are linked and weighted, so KoshaX knows who matters, what’s urgent, and what can wait.',
    actions: [
      { label: 'Knowledge graph', text: 'Mom → family · high priority · visiting' },
      { label: 'Pattern learned', text: 'Insurance renewals → yearly · reminder 7d before' },
      { label: 'Routine', text: 'Friday evenings → usually social' },
    ],
  },
  {
    verb: 'Think',
    stage: 'Understand',
    title: 'It connects the dots.',
    body: 'This is where raw context becomes understanding. KoshaX reasons across everything it knows, weighing what actually matters to you right now.',
    how: 'Reasoning ranks competing demands against your goals and current moment — not just what’s loudest or most recent.',
    actions: [
      { label: 'Reasoning', text: 'Mom lands Sat 6pm → leave by 4:30pm for DEL traffic' },
      { label: 'Trade-off', text: 'Dinner clashes with airport run → suggest reschedule' },
    ],
  },
  {
    verb: 'Anticipate',
    stage: 'Act',
    title: 'It thinks ahead for you.',
    body: 'KoshaX tracks your habits and plans, then nudges you gently at the right moment — the right thing surfacing exactly when you need it, before you even ask.',
    how: 'A habit engine and life planner schedule nudges by timing and context, with streaks that recover after a missed day.',
    actions: [
      { label: 'Nudge · today 4:00pm', text: 'Leave soon to pick up Mom from DEL T3' },
      { label: 'Nudge · in 5 days', text: 'Renew car insurance before it lapses' },
      { label: 'This week planned', text: 'Meals · meds · groceries ✓' },
    ],
  },
  {
    verb: 'Coordinate',
    stage: 'Act',
    title: 'It extends beyond you.',
    body: 'Life isn’t solo. KoshaX shares context and handles logistics across your family and network, so plans stay in sync without the endless back-and-forth.',
    how: 'Shared context lets KoshaX propose, assign and confirm logistics across people — with each person seeing only what’s relevant to them.',
    actions: [
      { label: 'Shared with family', text: 'Sat: Dad drops, you pick up Mom' },
      { label: 'Auto-sent', text: '“Shifting Sharma dinner to Sunday — ok?”' },
      { label: 'Grocery run', text: 'Assigned to whoever’s closest' },
    ],
  },
];
---

<section id="capture" class="section solution" data-solutions>
  {/* Invisible anchors so the other verbs' deep links still land here
      (the hashchange handler below also selects the matching tab). */}
  <span id="calibrate" class="solution__anchor" aria-hidden="true"></span>
  <span id="think" class="solution__anchor" aria-hidden="true"></span>
  <span id="anticipate" class="solution__anchor" aria-hidden="true"></span>
  <span id="coordinate" class="solution__anchor" aria-hidden="true"></span>

  <div class="container">
    <div class="solution__head section__head" data-sr>
      <p class="eyebrow">But life never stops</p>
      <h2 class="section__title">KoshaX ensures you always stay on top</h2>
      <p class="lede" style="margin-top:1rem">
        KoshaX turns the chaos of daily life into the right action, at the right time — for you and
        everyone you coordinate with.
      </p>
    </div>

    <div class="solution__tabs" role="tablist" aria-label="What KoshaX does">
      {
        solutions.map((s, i) => (
          <button
            type="button"
            class:list={['solution__tab', { 'is-active': i === 0 }]}
            id={`tab-${s.verb.toLowerCase()}`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${s.verb.toLowerCase()}`}
          >
            {s.verb}
          </button>
        ))
      }
    </div>

    <div class="solution__panels">
      {
        solutions.map((s, i) => (
          <div
            class:list={['solution__panel', { 'is-active': i === 0 }]}
            id={`panel-${s.verb.toLowerCase()}`}
            role="tabpanel"
            aria-labelledby={`tab-${s.verb.toLowerCase()}`}
          >
            {/* ---- Text column (left) ---- */}
            <div class="solution__text">
              <div class="solution__heading">
                <h3 class="solution__title">{s.title}</h3>
                <span class="solution__stage">{s.stage}</span>
              </div>
              <p class="solution__body lede">{s.body}</p>
              <div class="solution__how">
                <p class="solution__label">How it works</p>
                <p class="solution__how-text">{s.how}</p>
              </div>
            </div>

            {/* ---- "In action" panel (right): example cards ---- */}
            <aside class="solution__action">
              <p class="solution__label">In action</p>
              <ul class="solution__chips">
                {s.actions.map((a) => (
                  <li class="solution__chip">
                    <span class="solution__chip-label">{a.label}</span>
                    <p class="solution__chip-text">{a.text}</p>
                  </li>
                ))}
              </ul>
            </aside>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .solution {
    position: relative;
  }

  .solution__anchor {
    position: absolute;
    top: 0;
  }

  .solution__head {
    margin-bottom: clamp(2rem, 4vw, 3.5rem);
  }

  /* ---- The verb switcher — headline-as-tabs (Samachar/Vichaar/Vyapaar ref):
     the verbs sit side by side at display size; the active one is full
     ink with an accent underline, the others recede to a soft grey. ---- */
  .solution__tabs {
    display: flex;
    justify-content: flex-start;
    align-items: baseline;
    flex-wrap: wrap;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-bottom: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  .solution__tab {
    position: relative;
    cursor: pointer;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: color-mix(in srgb, var(--ink) 28%, transparent);
    background: none;
    border: none;
    padding: 0.1rem 0 0.35rem;
    transition: color 300ms var(--ease);
  }

  /* Accent underline draws in beneath the selected verb. */
  .solution__tab::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 3px;
    border-radius: 3px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms var(--ease);
  }

  .solution__tab.is-active::after {
    transform: scaleX(1);
  }

  .solution__tab:hover {
    color: color-mix(in srgb, var(--ink) 55%, transparent);
  }

  .solution__tab.is-active {
    color: var(--ink);
  }

  .solution__tab:focus-visible {
    outline: 2px solid var(--accent-bright);
    outline-offset: 4px;
    border-radius: 4px;
  }

  /* ---- Panels ----
     Default (no JS): the five views simply stack, all visible.
     Enhanced (JS adds .is-enhanced): panels share one grid cell and
     crossfade as the switcher rotates. */
  .solution__panel {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: start;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .solution__panel + .solution__panel {
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .is-enhanced .solution__panels {
    display: grid;
  }

  .is-enhanced .solution__panel {
    grid-area: 1 / 1;
    margin-top: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(12px);
    transition:
      opacity 450ms var(--ease),
      transform 450ms var(--ease),
      visibility 0s linear 450ms;
  }

  .is-enhanced .solution__panel.is-active {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  /* ---- Text column ---- */
  .solution__text {
    max-width: 34rem;
  }

  .solution__heading {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .solution__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0;
  }

  /* Stage badge — Learn / Understand / Act */
  .solution__stage {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--accent-deep);
    background: var(--accent-tint);
    border-radius: var(--radius-pill);
    padding: 0.3rem 0.75rem;
  }

  .solution__body {
    margin: 1rem 0 1.75rem;
  }

  /* Shared small-caps label for the explainer + action panels */
  .solution__label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin: 0 0 0.7rem;
  }

  /* "How it works" explainer box */
  .solution__how {
    background: var(--paper-warm);
    border-radius: var(--radius-sm);
    padding: 1.25rem 1.4rem;
  }

  .solution__how-text {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--ink-body);
  }

  /* ---- "In action" panel: tinted shell, white example cards ---- */
  .solution__action {
    background: var(--paper-warm);
    border-radius: var(--radius);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .solution__chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }

  .solution__chip {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    padding: 0.9rem 1.1rem;
  }

  .solution__chip-label {
    display: block;
    font-size: 0.85rem;
    color: var(--ink-soft);
    margin-bottom: 0.2rem;
  }

  .solution__chip-text {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.45;
    color: var(--ink-body);
  }

  /* ---- Mobile: single column, action panel below the text ---- */
  @media (max-width: 880px) {
    .solution__panel {
      grid-template-columns: 1fr;
    }
    .solution__text {
      max-width: none;
    }
  }

  /* ---- Phones: keep all five verbs on ONE line. Stop wrapping, shrink the
     verbs with the viewport and spread them edge-to-edge. Falls back to a
     quiet horizontal scroll on ultra-narrow screens rather than wrapping. ---- */
  @media (max-width: 480px) {
    .solution__tabs {
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: clamp(0.2rem, 1vw, 0.6rem);
      overflow-x: auto;
      scrollbar-width: none;
    }
    .solution__tabs::-webkit-scrollbar {
      display: none;
    }
    .solution__tab {
      font-size: clamp(0.8rem, 3.7vw, 1.4rem);
      letter-spacing: -0.03em;
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .solution__tab,
    .solution__tab::after {
      transition: none;
    }
    .is-enhanced .solution__panel {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  // Verb switcher: auto-rotates Capture → Calibrate → Think → Anticipate →
  // Coordinate while the
  // section is on screen. A click (or a #filter/#anticipate deep link) selects
  // that view and stops the rotation — the user has taken the wheel.
  const root = document.querySelector<HTMLElement>('[data-solutions]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root) {
    root.classList.add('is-enhanced');
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.solution__tab')];
    const panels = [...root.querySelectorAll<HTMLElement>('.solution__panel')];

    let idx = 0;
    let timer: ReturnType<typeof setInterval> | null = null;
    let locked = false; // user clicked — stop auto-rotating

    const select = (i: number) => {
      idx = i;
      tabs.forEach((t, ti) => {
        t.classList.toggle('is-active', ti === i);
        t.setAttribute('aria-selected', String(ti === i));
      });
      panels.forEach((p, pi) => p.classList.toggle('is-active', pi === i));
    };

    const stop = () => {
      if (timer) clearInterval(timer);
      timer = null;
    };
    const start = () => {
      if (!reduce && !locked && !timer)
        timer = setInterval(() => select((idx + 1) % tabs.length), 5000);
    };

    tabs.forEach((t, i) =>
      t.addEventListener('click', () => {
        locked = true;
        stop();
        select(i);
      })
    );

    // Deep links (#capture … #coordinate) select the matching view.
    const byHash = () => {
      const i = tabs.findIndex((t) => `#${t.id.slice(4)}` === location.hash);
      if (i >= 0) {
        locked = true;
        stop();
        select(i);
      }
    };
    window.addEventListener('hashchange', byHash);
    byHash();

    // Rotate only while the section is actually in view.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => (e.isIntersecting ? start() : stop())),
        { threshold: 0.25 }
      ).observe(root);
    } else {
      start();
    }
  }
</script>
