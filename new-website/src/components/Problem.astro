  },
  {
    text: '15 mins to find a boarding pass',
    rot: 5,
    dy: 0,
    icon: `<svg viewBox="0 0 46 46" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M21.12 36.3358L16.7566 30.307L9.72204 27.743L11.2601 25.7146L17.0936 25.8839L21.4212 20.1435L8.29756 16.5961L10.2688 13.997L25.6921 14.4666L30.1146 8.5631C30.5117 8.03501 31.0459 7.72387 31.7171 7.62969C32.3883 7.5355 32.9875 7.68761 33.5146 8.086C34.044 8.48408 34.3555 9.01707 34.4492 9.68497C34.543 10.3529 34.3907 10.9509 33.9925 11.4792L29.5254 17.3654L34.2223 32.0552L32.2444 34.6789L25.2435 23.0354L20.9158 28.7758L22.6553 34.2994L21.12 36.3358Z" fill="currentColor"/></svg>`,
  },
  {
    text: '300+ unread emails by Monday',
    rot: 8,
    dy: 26,
    icon: `<svg viewBox="0 0 49 49" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><g clip-path="url(#clip_mail)"><path d="M9.58806 32.5791C8.84645 32.3804 8.29415 31.9667 7.93117 31.338C7.56818 30.7093 7.48566 30.0234 7.68359 29.2805L12.3285 11.9453C12.5272 11.2037 12.9415 10.6515 13.5713 10.2888C14.201 9.92615 14.8858 9.84334 15.6256 10.0404L39.4034 16.4117C40.144 16.6101 40.6956 17.0242 41.0583 17.654C41.421 18.2837 41.5037 18.9691 41.3063 19.7099L36.6609 37.0466C36.4625 37.7872 36.0483 38.3393 35.4182 38.7031C34.7881 39.0669 34.1035 39.1491 33.3643 38.9499L9.58806 32.5791ZM24.4449 24.6819L39.5804 19.7116L39.4663 18.154L24.9263 22.8853L14.7 11.5179L13.8224 12.8097L24.4449 24.6819Z" fill="currentColor"/></g><defs><clipPath id="clip_mail"><rect width="40" height="40" fill="white" transform="translate(10.3528) rotate(15)"/></clipPath></defs></svg>`,
  },
