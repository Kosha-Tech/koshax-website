---

<section class="section section--tint problem" id="use-cases">
  <div class="container">
    <div class="problem__head" data-sr>
      <p class="eyebrow">Why it’s hard</p>
      <h2 class="section__title">You’re not disorganised. Your tools are.</h2>
    </div>

    <div class="problem__cards">
      {
        cards.map((c, i) => (
          <article
            class="pcard"
            style={`--rot:${c.rot}deg;--dy:${c.dy}px;--i:${i};--gx:${((1.5 - i) * 11.8).toFixed(2)}rem`}
          >
            <span class="pcard__icon" set:html={c.icon} />
            <p class="pcard__text">{c.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Tuck the hero phone UNDER this section: pull the band up over the phone's
     lower body, paint above it (z-index), and let the top edge fade in from
     transparent so the phone shows through and dissolves into the tint. The
     heading sits below that overlap (padding-top), so it clears the phone. */
  .problem {
    position: relative;
    z-index: 3; /* above the hero phone (z-index 2) */
    margin-top: clamp(-130px, -10vw, -100px);
    padding-top: clamp(150px, 13vw, 200px);
    padding-bottom: var(--section-y);
    /* Fully OPAQUE band: an 80% peach→lavender tint over a solid white base.
       The white base is full-height, so the hero phone is hidden cleanly behind
       the band (no ghosting / smearing). The tint fades in from transparent at
       the very top, so the band's top edge is plain white — seamless with the
       hero's white above it (no visible seam). */
    background:
      linear-gradient(
        to bottom,
        transparent 0,
        color-mix(in srgb, var(--tint-peach) 80%, transparent) 160px,
        color-mix(in srgb, var(--tint-lavender) 80%, transparent)
      ),
      var(--paper);
  }

  /* The hero phone now fades out on its own (masked in Hero.astro), so the band
     needs no overlap trickery — it simply starts as a clean opaque gradient. */

  /* ---- Heading: pinned at the top, centered (Figma) ---- */
  .problem__head {
    max-width: 46rem;
    margin: 0 auto;
    text-align: center;
  }

  /* ---- The fanned stack of symptom cards ---- */
  .problem__cards {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    padding-bottom: clamp(1.5rem, 4vw, 3rem); /* room for the tilt + shadow */
  }

  /* ---- A single symptom card: icon top-left, line of text below ---- */
  .pcard {
    flex: 0 0 auto;
    width: clamp(13rem, 17vw, 16.5rem);
    min-height: clamp(17rem, 21vw, 20.5rem);
    padding: clamp(1.4rem, 2vw, 2rem);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;

    background: var(--paper);
    border-top: 2px solid var(--accent); /* the blue thread along the top */
    border-radius: var(--radius);
    box-shadow: 0 32px 64px -12px rgba(16, 24, 40, 0.16);

    /* Overlap the previous card, then tilt + lift into the arc. Rotate about
       the centre so the lower (text) ends fan apart rather than stacking. */
    transform: translateY(var(--dy)) rotate(var(--rot));
    transform-origin: center center;
  }
  .pcard:not(:first-child) {
    margin-left: clamp(-1.5rem, -1vw, -0.6rem);
  }
  /* Stack left → right so each card overlaps the one before it. */
  .pcard:nth-child(1) { z-index: 1; }
  .pcard:nth-child(2) { z-index: 2; }
  .pcard:nth-child(3) { z-index: 3; }
  .pcard:nth-child(4) { z-index: 4; }

  .pcard__icon {
    color: var(--accent);
    width: clamp(2.4rem, 3vw, 3rem);
    height: clamp(2.4rem, 3vw, 3rem);
  }
  .pcard__icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
  }

  .pcard__text {
    margin: 0;
    margin-top: auto; /* push the line to the lower portion of the card */
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 1.35vw, 1.32rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--ink-body);
  }

  /* ---- Scroll reveal: the cards start gathered into a flat, centred stack
     (--gx pulls each toward the middle, no tilt) and FAN OUT to their resting
     fanned positions when the section scrolls in — spreading apart, tilting,
     and lifting into the arc, one after another. ---- */
  .problem.is-armed .pcard {
    opacity: 0;
    transform: translateX(var(--gx)) translateY(calc(var(--dy) + 10px))
      rotate(0deg) scale(0.96);
  }
  .problem.is-armed.is-shown .pcard {
    opacity: 1;
    transform: translateY(var(--dy)) rotate(var(--rot)) scale(1);
    transition:
      opacity 420ms var(--ease),
      transform 820ms var(--ease);
    transition-delay: calc(var(--i) * 110ms);
  }

  /* ---- Mobile: drop the fan, stack the cards upright in a calm grid ---- */
  @media (max-width: 760px) {
    .problem__cards {
      flex-wrap: wrap;
      gap: 0.85rem;
      max-width: 30rem;
      margin-inline: auto;
    }
    .pcard {
      width: calc(50% - 0.5rem);
      min-height: 0;
      gap: 1rem;
      transform: none;
    }
    .pcard:not(:first-child) {
      margin-left: 0;
    }
    .pcard__text {
      font-size: 1.02rem;
    }
    /* never tilt / offset on the stacked mobile layout */
    .problem.is-armed .pcard,
    .problem.is-armed.is-shown .pcard {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .problem.is-armed .pcard,
    .problem.is-armed.is-shown .pcard {
      opacity: 1;
      transition: none;
      transform: translateY(var(--dy)) rotate(var(--rot));
    }
    @media (max-width: 760px) {
      .problem .pcard { transform: none; }
    }
  }
</style>

<script>
  // Fan the cards out from a gathered stack when the section scrolls into
  // view. Plays once. Reduced motion / no-JS keep the resting fanned state.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const section = document.querySelector<HTMLElement>('.problem');
  const cards = section?.querySelector<HTMLElement>('.problem__cards');

  if (section && cards && !reduce && 'IntersectionObserver' in window) {
    section.classList.add('is-armed');
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            section.classList.add('is-shown');
            io.disconnect();
          }
        }
      },
      { threshold: 0.2 }
    );
    io.observe(cards);
  }
</script>
