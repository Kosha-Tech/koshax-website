---
// Built right (security) · eyebrow "Built right" (§8).
// Icons are lucide-style 24×24 stroke paths in tinted chips — same visual
// language as the Problem cards, each with its own mood colour (--c).
const features = [
  {
    color: '#1D9E75',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>`,
    name: 'Privacy by design',
    desc: 'Email access is strictly read-only. Nothing you share with Kosha is sold, stored on third-party servers, or used to train models. Your personal life is yours — Kosha just helps you navigate it.',
  },
  {
    color: '#378ADD',
    icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/></svg>`,
    name: 'Works where life happens',
    desc: 'On the go or winding down at home, Kosha is there — iOS, Android, and wherever your day takes you. One experience across every device and channel.',
  },
];

const certs = ['CASA Certified', 'ISO 27001', 'SOC 2 Type II'];
---

<section class="section security" id="security">
  <div class="container">
    <div class="security__grid">
      <div class="security__intro" data-sr>
        <p class="eyebrow">Built right</p>
        <h2 class="section__title">Designed around trust, not engagement.</h2>
      </div>

      <ul class="security__features" data-sr data-sr-delay="1">
        {
          features.map((f) => (
            <li class="security__feature" style={`--c:${f.color}`}>
              <span class="security__icon" set:html={f.icon} />
              <div>
                <h3 class="security__name">{f.name}</h3>
                <p class="security__desc">{f.desc}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="security__certs" data-sr>
      <ul class="security__cert-row">
        {
          certs.map((c) => (
            <li class="security__cert">
              <span class="security__cert-mark" aria-hidden="true">✓</span>
              {c}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .security__grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .security__features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .security__feature {
    display: flex;
    gap: 0.9rem;
  }

  .security__icon {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 18%, transparent);
  }
  .security__icon :global(svg) {
    width: 21px;
    height: 21px;
    display: block;
  }

  .security__name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    margin: 0 0 0.4rem;
  }

  .security__desc {
    color: var(--ink-soft);
    margin: 0;
  }

  .security__certs {
    border-top: 1px solid var(--line);
    padding-top: 1.75rem;
  }

  .security__cert-row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .security__cert {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--ink);
  }

  .security__cert-mark {
    color: var(--gold); /* gold whisper — the verification marks */
  }

  @media (max-width: 760px) {
    .security__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
