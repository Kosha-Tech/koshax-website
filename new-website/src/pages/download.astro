---
// /download — mirrors the current site's DownloadPage.jsx: on iOS/Android it
// auto-redirects straight to the right store; on desktop (or if redirect
// fails) it shows both store badges. Reached as the desktop fallback from
// any .download-trigger CTA (see Layout.astro).
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

const APP_STORE_URL = 'https://apps.apple.com/in/app/koshax/id6761248820';
const PLAY_STORE_URL =
  'https://play.google.com/store/apps/details?id=com.koshax.ai&hl=en_IN';
---

<Layout
  title="Download KoshaX"
  description="Get KoshaX on iOS and Android. Free to start — no account required to explore, no credit card ever."
>
  <Nav />
  <main class="download">
    <div class="container download__inner">
      <img class="download__logo" src="/kosha-logo-blue.svg" alt="KoshaX" width="120" height="40" />
      <h1 class="download__title" data-download-title>Download KoshaX</h1>
      <p class="download__sub" data-download-sub>Available on iOS and Android.</p>

      <div class="download__buttons">
        <a class="download__btn" href={APP_STORE_URL} target="_blank" rel="noopener noreferrer">
          <svg class="download__btn-icon" viewBox="0 0 384 512" fill="currentColor" aria-hidden="true">
            <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z"/>
          </svg>
          <span class="download__btn-text">
            <span class="download__btn-eyebrow">Download on the</span>
            <span class="download__btn-store">App Store</span>
          </span>
        </a>
        <a class="download__btn" href={PLAY_STORE_URL} target="_blank" rel="noopener noreferrer">
          <svg class="download__btn-icon" viewBox="0 0 512 512" aria-hidden="true">
            <path fill="#00D4FF" d="M325.3 234.3 104.6 13l280.8 161z"/>
            <path fill="#FFCE00" d="m104.6 499 220.7-221.3L385.4 338z"/>
            <path fill="#FF3A44" d="M385.4 338 104.6 499V13l280.8 161z"/>
            <path fill="#00F076" d="M325.3 277.7 104.6 499V13l220.7 264.7z" opacity=".8"/>
          </svg>
          <span class="download__btn-text">
            <span class="download__btn-eyebrow">Get it on</span>
            <span class="download__btn-store">Google Play</span>
          </span>
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .download {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding-block: var(--section-y);
    background:
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--tint-peach) 50%, transparent),
        color-mix(in srgb, var(--tint-lavender) 50%, transparent)
      ),
      var(--paper);
  }

  .download__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .download__logo {
    width: 120px;
    height: auto;
    margin-bottom: 2rem;
  }

  .download__title {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: 500;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0 0 0.75rem;
  }

  .download__sub {
    color: var(--ink-soft);
    margin: 0 0 2.5rem;
    max-width: 40ch;
  }

  .download__buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  /* Store badges — dark indigo pills, the classic two-line store-badge layout. */
  .download__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1.4rem;
    background: var(--ink);
    color: #fff;
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: transform var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }

  .download__btn:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .download__btn-icon {
    width: 26px;
    height: 26px;
    flex: none;
  }

  .download__btn-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.15;
  }

  .download__btn-eyebrow {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .download__btn-store {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .download__btn,
    .download__btn:hover {
      transition: none;
      transform: none;
    }
  }
</style>

<script>
  // Auto-redirect on mobile, exactly like DownloadPage.jsx: replace() to the
  // right store and swap the copy to the "redirecting" state. Desktop stays
  // and uses the badges.
  const APP_STORE_URL = 'https://apps.apple.com/in/app/koshax/id6761248820';
  const PLAY_STORE_URL =
    'https://play.google.com/store/apps/details?id=com.koshax.ai&hl=en_IN';

  const ua = navigator.userAgent || '';
  const isIpadOS = /Macintosh/.test(ua) && navigator.maxTouchPoints > 1;
  const platform =
    /iPhone|iPad|iPod/.test(ua) || isIpadOS ? 'ios' : /Android/i.test(ua) ? 'android' : 'other';

  if (platform !== 'other') {
    const title = document.querySelector('[data-download-title]');
    const sub = document.querySelector('[data-download-sub]');
    if (title) title.textContent = 'Redirecting to your store…';
    if (sub) sub.textContent = 'If you are not redirected automatically, use the links below.';
    window.location.replace(platform === 'ios' ? APP_STORE_URL : PLAY_STORE_URL);
  }
</script>
